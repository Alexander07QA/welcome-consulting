# Consultorio de Gabi en Hostinger (carpeta public_html/consultorio)
# Los archivos de assets/ llevan huella en el nombre: se guardan en caché un año.
# index.html no se guarda, para que cada versión nueva se vea de inmediato.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
